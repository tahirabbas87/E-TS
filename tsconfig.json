{
  "compilerOptions": {
    "target": "es2016",
    "lib": [
      "es2016",
      "es2017",
      "dom"
    ],
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "./src"
  },
  "include": [
    "src",
    "node_modules/@types/jest/index.d.ts"
  ]
}